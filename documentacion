  height: 15px;
  border-left: 1px solid var(--nav-splitbar-handle-color);
  border-right: 1px solid var(--nav-splitbar-handle-color);
  position: absolute;
}

#page-nav-resize-handle.dragging,
#page-nav-resize-handle:hover {
  opacity: 1;
}

#page-nav-contents {
  padding: 0;
