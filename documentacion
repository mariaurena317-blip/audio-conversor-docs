var indexSectionsWithContent =
{
  0: "cdf",
  1: "f",
  2: "c",
  3: "df"
};

var indexSectionNames =
{
  0: "all",
  1: "classes",
  2: "namespaces",
  3: "functions"
};

var indexSectionLabels =
{
  0: "All",
  1: "Classes",
  2: "Namespaces",
  3: "Functions"
};

